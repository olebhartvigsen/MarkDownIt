<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="MarkDownIt"
           Version="$(var.ProductVersion)"
           Manufacturer="Ole Hartvigsen"
           UpgradeCode="0041C647-DB4D-4C4C-A047-29AA1C091D74"
           Language="1033"
           Scope="perUser">

    <SummaryInformation Description="MarkDownIt: a native Windows markdown viewer and editor" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of MarkDownIt is already installed."
                  Schedule="afterInstallExecute" />

    <!-- Ensure any running MarkDownIt.exe is closed before files are replaced on upgrade. -->
    <util:CloseApplication Id="CloseRunningMarkDownIt"
                           Target="MarkDownIt.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           TerminateProcess="10"
                           EndSessionMessage="yes" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- %LOCALAPPDATA%\MarkDownIt -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="MarkDownIt" />
    </StandardDirectory>

    <!-- %APPDATA%\Microsoft\Windows\Start Menu\Programs\MarkDownIt -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuMarkDownIt" Name="MarkDownIt" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Main executable -->
    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="17156AC2-A2E4-4E2B-A0E4-E458A8BCD143">
        <File Id="MarkDownItExe"
              Source="..\build\Release\MarkDownIt.exe"
              Name="MarkDownIt.exe" />
        <!-- Per-user install requires HKCU registry KeyPath, not a file (ICE38) -->
        <RegistryValue Root="HKCU"
                       Key="Software\MarkDownIt"
                       Name="InstallDir"
                       Value="[INSTALLFOLDER]"
                       Type="string"
                       KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- Shortcuts -->
    <ComponentGroup Id="ShortcutComponents">

      <!-- Start Menu shortcut -->
      <Component Id="StartMenuShortcut" Directory="StartMenuMarkDownIt"
                 Guid="849E91FA-A1D3-4927-8062-F41C929020A2">
        <Shortcut Id="StartMenuShortcutLink"
                  Name="MarkDownIt"
                  Description="Native Windows markdown viewer and editor"
                  Target="[INSTALLFOLDER]MarkDownIt.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuFolder" Directory="StartMenuMarkDownIt" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\MarkDownIt\Shortcuts"
                       Name="StartMenu"
                       Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- Desktop shortcut -->
      <Component Id="DesktopShortcut" Directory="DesktopFolder"
                 Guid="CFE3A68E-B599-43C1-8743-B7277D88E802">
        <Shortcut Id="DesktopShortcutLink"
                  Name="MarkDownIt"
                  Description="Native Windows markdown viewer and editor"
                  Target="[INSTALLFOLDER]MarkDownIt.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\MarkDownIt\Shortcuts"
                       Name="Desktop"
                       Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- Features -->
    <Feature Id="ProductFeature" Title="MarkDownIt" Level="1">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

    <!-- Launch app after install -->
    <CustomAction Id="LaunchApp"
                  FileRef="MarkDownItExe"
                  ExeCommand=""
                  Execute="immediate"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <!-- Only on fresh install or upgrade, not on uninstall -->
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <!-- Minimal UI (license screen + install) -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
  <Application.Views>
    <Ribbon>
      <Ribbon.ApplicationMenu>
        <ApplicationMenu CommandName="cmdAppMenu">
          <MenuGroup Class="MajorItems">
            <Button CommandName="cmdAbout" />
          </MenuGroup>
          <MenuGroup Class="StandardItems">
            <Button CommandName="cmdAssocMd" />
          </MenuGroup>
          <MenuGroup Class="StandardItems">
            <DropDownButton CommandName="cmdWidthMenu">
              <MenuGroup>
                <Button CommandName="cmdWidthStandard" />
                <Button CommandName="cmdWidth960" />
                <Button CommandName="cmdWidth1600" />
                <Button CommandName="cmdWidthFull" />
              </MenuGroup>
            </DropDownButton>
          </MenuGroup>
        </ApplicationMenu>
      </Ribbon.ApplicationMenu>
      <Ribbon.Tabs>
        <Tab CommandName="cmdTabHome">
          <Group CommandName="cmdGroupFile" SizeDefinition="ThreeButtons">
            <Button CommandName="cmdOpen" />
            <Button CommandName="cmdReload" />
            <Button CommandName="cmdSave" />
          </Group>
          <Group CommandName="cmdGroupEdit" SizeDefinition="TwoButtons">
            <Button CommandName="cmdUndo" />
            <Button CommandName="cmdRedo" />
          </Group>
          <Group CommandName="cmdGroupFormat" SizeDefinition="SixButtons">
            <ToggleButton CommandName="cmdBold" />
            <ToggleButton CommandName="cmdItalic" />
            <ToggleButton CommandName="cmdStrike" />
            <ToggleButton CommandName="cmdCode" />
            <Button CommandName="cmdLink" />
            <Button CommandName="cmdClearFormat" />
          </Group>
          <Group CommandName="cmdGroupParagraph" SizeDefinition="SevenButtons">
            <ToggleButton CommandName="cmdHeading1" />
            <ToggleButton CommandName="cmdHeading2" />
            <ToggleButton CommandName="cmdHeading3" />
            <ToggleButton CommandName="cmdBullets" />
            <ToggleButton CommandName="cmdNumbering" />
            <ToggleButton CommandName="cmdQuote" />
            <ToggleButton CommandName="cmdEditToggle" />
          </Group>
          <Group CommandName="cmdGroupView" SizeDefinition="ThreeButtons">
            <ToggleButton CommandName="cmdWrap" />
            <Button CommandName="cmdZoomIn" />
            <Button CommandName="cmdZoomOut" />
          </Group>
        </Tab>
      </Ribbon.Tabs>
    </Ribbon>
  </Application.Views>
</Application>
